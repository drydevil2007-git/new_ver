# GEMINI_API_KEY: required for server-side Gemini calls. NEVER commit a real key
# and NEVER put it in client code (anything in src/ ships to the browser).
GEMINI_API_KEY=""

# ADMIN_TOKEN: secret for /api/admin/* (sent as the x-admin-token header).
# In production the admin API is disabled unless this is set.
ADMIN_TOKEN=""

# APP_URL: public URL of the deployment.
APP_URL="https://danshyar.ir"
