# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Enable Email/Password and Google providers in Firebase Authentication.
# Optional override; by default the server uses the Firebase app configuration.
FIREBASE_API_KEY="MY_FIREBASE_API_KEY"

# Comma-separated Firebase account emails allowed to access admin APIs.
ADMIN_EMAILS="drydevil2007@gmail.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional provider credentials improve academic search rate limits.
OPENALEX_API_KEY=""
SEMANTIC_SCHOLAR_API_KEY=""
# Optional contact address recommended by Crossref for polite API usage.
CROSSREF_MAILTO=""
